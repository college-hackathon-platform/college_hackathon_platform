// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  role         UserRole      @default(STUDENT)
  // Use ACTIVE as the default for normal provisioning so the account can authenticate immediately.
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refreshTokens RefreshToken[]
  createdEvents Event[] @relation("EventCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([role, status, createdAt])
}

model Event {
  id                     String      @id @default(uuid()) @db.Uuid
  title                  String      @db.VarChar(180)
  slug                   String      @unique @db.VarChar(220)
  shortDescription       String      @default("") @db.VarChar(300)
  description            String      @default("") @db.Text
  status                 EventStatus @default(DRAFT)
  mode                   EventMode   @default(ONLINE)
  startDate              DateTime?
  endDate                DateTime?
  registrationStartDate  DateTime?
  registrationEndDate    DateTime?
  venue                  String?     @db.VarChar(255)
  registrationCapacity   Int?
  minTeamSize            Int         @default(1)
  maxTeamSize            Int         @default(1)
  eligibility            String?     @db.VarChar(1000)
  rules                  String?     @db.Text
  createdById            String      @db.Uuid
  publishedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  createdBy User @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([mode])
  @@index([startDate])
  @@index([createdAt])
  @@index([status, mode, startDate])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Cascade deletion keeps the token history consistent when a user is removed.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}
