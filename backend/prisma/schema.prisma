// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
  DISBANDED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
  WAITLISTED
}

enum EventEvaluatorInvitationStatus {
  PENDING
  REVOKED
  EXPIRED
}

enum EventEvaluatorEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PlatformStatus {
  ONLINE
  DEGRADED
  MAINTENANCE
}

model PlatformSettings {
  id                     String         @id @default("default") @db.VarChar(36)
  platformName           String         @default("College Hackathon Platform") @db.VarChar(180)
  platformDescription    String         @default("") @db.VarChar(1000)
  supportEmail           String         @default("") @db.VarChar(255)
  timezone               String         @default("UTC") @db.VarChar(100)
  platformStatus         PlatformStatus @default(ONLINE)
  allowEventCreation     Boolean        @default(true)
  registrationEnabled    Boolean        @default(true)
  maintenanceMode        Boolean        @default(false)
  maintenanceMessage     String         @default("The platform is temporarily undergoing maintenance. Please try again later.") @db.VarChar(1000)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  role         UserRole      @default(STUDENT)
  // Use ACTIVE as the default for normal provisioning so the account can authenticate immediately.
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refreshTokens RefreshToken[]
  createdEvents Event[] @relation("EventCreator")
  ledTeams Team[] @relation("TeamLeader")
  teamMemberships TeamMember[]
  reviewedRegistrations EventRegistration[] @relation("RegistrationReviewer")
  registrationStatusChanges RegistrationStatusHistory[] @relation("RegistrationStatusChanger")
  facultyAssignments EventFacultyAssignment[] @relation("AssignedFaculty")
  createdFacultyAssignments EventFacultyAssignment[] @relation("FacultyAssignmentCreator")
  createdEvaluatorInvitations EventEvaluatorInvitation[] @relation("EvaluatorInvitationCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([role, status, createdAt])
}

model Event {
  id                     String      @id @default(uuid()) @db.Uuid
  title                  String      @db.VarChar(180)
  slug                   String      @unique @db.VarChar(220)
  shortDescription       String      @default("") @db.VarChar(300)
  description            String      @default("") @db.Text
  status                 EventStatus @default(DRAFT)
  mode                   EventMode   @default(ONLINE)
  startDate              DateTime?
  endDate                DateTime?
  registrationStartDate  DateTime?
  registrationEndDate    DateTime?
  venue                  String?     @db.VarChar(255)
  registrationCapacity   Int?
  minTeamSize            Int         @default(1)
  maxTeamSize            Int         @default(1)
  eligibility            String?     @db.VarChar(1000)
  rules                  String?     @db.Text
  createdById            String      @db.Uuid
  publishedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  createdBy User @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teams Team[]
  registrations EventRegistration[]
  facultyAssignments EventFacultyAssignment[]
  evaluatorInvitations EventEvaluatorInvitation[]

  @@index([status])
  @@index([mode])
  @@index([startDate])
  @@index([createdAt])
  @@index([status, mode, startDate])
}

model Team {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  description  String?    @db.Text
  inviteCodeHash String?  @db.VarChar(255)
  inviteExpiresAt DateTime?
  inviteRevokedAt DateTime?
  eventId      String     @db.Uuid
  leaderId     String     @db.Uuid
  status       TeamStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  leader User @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members TeamMember[]
  registrations EventRegistration[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([leaderId])
  @@index([status])
}

model TeamMember {
  id       String           @id @default(uuid()) @db.Uuid
  teamId   String           @db.Uuid
  userId   String           @db.Uuid
  role     TeamMemberRole
  status   TeamMemberStatus @default(ACTIVE)
  joinedAt DateTime?
  leftAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([userId, status])
}

model EventRegistration {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @db.Uuid
  teamId          String             @db.Uuid
  status          RegistrationStatus @default(DRAFT)
  registeredAt    DateTime?
  reviewedAt      DateTime?
  reviewedById    String?            @db.Uuid
  rejectionReason String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  history RegistrationStatusHistory[]

  @@unique([eventId, teamId])
  @@index([eventId])
  @@index([teamId])
  @@index([status])
  @@index([eventId, status])
}

model RegistrationStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  registrationId String             @db.Uuid
  fromStatus     RegistrationStatus
  toStatus       RegistrationStatus
  changedById    String             @db.Uuid
  reason         String?            @db.Text
  createdAt      DateTime           @default(now())

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  changedBy User @relation("RegistrationStatusChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([createdAt])
}

model EventFacultyAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  facultyId  String   @db.Uuid
  assignedById String @db.Uuid
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faculty User @relation("AssignedFaculty", fields: [facultyId], references: [id], onDelete: Cascade)
  assignedBy User @relation("FacultyAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([eventId, facultyId])
  @@index([eventId])
  @@index([facultyId])
  @@index([assignedById])
}

model EventEvaluatorInvitation {
  id           String                         @id @default(uuid()) @db.Uuid
  eventId      String                         @db.Uuid
  name         String                         @db.VarChar(255)
  email        String                         @db.VarChar(255)
  designation  String                         @db.VarChar(255)
  organization String?                        @db.VarChar(255)
  phone        String?                        @db.VarChar(40)
  invitationMessage String?                   @db.Text
  tokenHash    String                         @db.VarChar(64)
  status       EventEvaluatorInvitationStatus @default(PENDING)
  emailDeliveryStatus EventEvaluatorEmailDeliveryStatus @default(PENDING)
  emailDeliveryError String?                  @db.VarChar(500)
  emailedAt    DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String                         @db.Uuid
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User @relation("EvaluatorInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([eventId, status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Cascade deletion keeps the token history consistent when a user is removed.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}
